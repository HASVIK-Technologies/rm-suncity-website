# Google Sheets service account used by the server to read public school data.
# Keep real credentials in your deployment environment or a local ignored .env file.
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----\n"

# Optional canonical site URL used to generate absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=https://your-school-domain.example
